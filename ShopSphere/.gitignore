# ===================================================================
# ShopNest — Git Ignore Configuration
# ===================================================================

# Compiled Java class files
*.class

# Log files
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual machine crash logs
hs_err_pid*
replay_pid*

# Maven build directory
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# H2 Database files (keeps local tests isolated from remote git repo)
data/
*.mv.db
*.trace.db

# Eclipse IDE
.classpath
.project
.settings/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/
.factorypath

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini
